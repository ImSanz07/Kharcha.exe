```gitignore
# ==========================================
# Environment variables and secrets
# ==========================================
.env
.env.*
!.env.example
secrets.txt

# ==========================================
# Python / Django (Backend)
# ==========================================
__pycache__/
*.py[cod]
*$py.class
*.so
.Python

# Virtual environments
venv/
.venv/
env/
ENV/

# Django generated files
*.log
db.sqlite3
db.sqlite3-journal
media/
staticfiles/

# Python testing / coverage
.pytest_cache/
.coverage
htmlcov/
.tox/
.nox/

# ==========================================
# Node / React (Frontend)
# ==========================================
node_modules/
dist/
dist-ssr/
*.local

# Logs
logs/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# ==========================================
# Editors and IDEs
# ==========================================
.vscode/*
!.vscode/extensions.json
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# ==========================================
# Operating system
# ==========================================
.DS_Store
Thumbs.db
desktop.ini
